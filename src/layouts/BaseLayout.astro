---
import Nav from "../components/Nav.astro";
import "../styles/global.css";

const {
  title = "Aisling Strzoda — Graphic Designer",
  description = "The graphic design portfolio of Aisling Strzoda."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
  </body>
</html>

