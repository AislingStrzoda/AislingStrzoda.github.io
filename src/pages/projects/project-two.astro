---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Project Two — Aisling Strzoda" description="Project Two by Aisling Strzoda.">
  <article class="project-page">
    <header class="project-header">
      <div>
        <p class="eyebrow">Selected work</p>
        <h1>Formula Trinity</h1>
      </div>
      <p>
        Formula Trinity is Trinity College Dublin’s Formula Student team, 
        which designs and builds a race car to compete at Silverstone. 
        <br>
        I developed the visual identity of the car through its livery, sponsor graphics and hand-painted details, as well as designing merchandise for the team. 
        The project involved translating an existing brand into a bold visual system that worked across both the car and apparel.

      </p>
    </header>

    <div class="project-media" aria-label="Project media placeholders">
      <img
        class="project-media__image"
        src="/images/projects/full_car.jpeg"
        alt="Full Formula Trinity race car livery design."
      />
      <div class="media-placeholder media-placeholder--wide" aria-hidden="true"></div>
      <div class="media-pair">
        <div class="media-placeholder media-placeholder--square" aria-hidden="true"></div>
        <div class="media-placeholder media-placeholder--square" aria-hidden="true"></div>
      </div>
    </div>

    <a class="back-link" href="/gallery">← Back to gallery</a>
  </article>
</BaseLayout>
