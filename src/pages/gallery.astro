---
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Gallery — Aisling Strzoda" description="Selected graphic design projects by Aisling Strzoda.">
  <header class="page-heading">
    <h1>Gallery</h1>
  </header>

  <section class="project-gallery" aria-label="Selected projects">
    <ProjectCard title="Project One" detail="Project type · Year" href="/projects/project-one" shape="portrait" />
    <ProjectCard
      title="Formula Trinity"
      detail="Race Car Livery · 2026"
      href="/projects/project-two"
      shape="landscape"
      image="/images/projects/car_number_close.jpeg"
      imageAlt="Close-up of racing car number 132 and sponsor graphics"
    />
    <ProjectCard title="Project Three" detail="Project type · Year" href="/projects/project-three" shape="square" />
  </section>
</BaseLayout>
