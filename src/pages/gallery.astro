---
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Gallery — Aisling Strzoda" description="Selected graphic design projects by Aisling Strzoda.">
  <header class="page-heading">
    <h1>Gallery</h1>
  </header>

  <section class="project-gallery" aria-label="Selected projects">
    <!-- Blemish Patches -->
    <ProjectCard
      title="Blemish Patches"
      detail="Package Design · 2025"
      href="/projects/blemish_patches"
      shape="portrait"
      image="/images/projects/blemish_patches/bp_gallery_hero.JPG"
      imageAlt="Blemish patches packaging featuring floral design"
    />

    <!-- DS Monogram -->
    <ProjectCard
      title="DS Monogram"
      detail="Logo Design · 2025"
      href="/projects/ds_monogram"
      shape="square"
      image="/images/projects/ds_monogram/dsm_hero_img.png"
      imageAlt="Fish and Hook DS Monogram logo"
    />

    <!-- Formula Trinity -->
    <ProjectCard
      title="Formula Trinity"
      detail="Race Car Livery · 2026"
      href="/projects/formula_trinity"
      shape="landscape"
      image="/images/projects/car_number_close.jpeg"
      imageAlt="Close-up of racing car number 132 and sponsor graphics"
    />

    <!-- The Last Bite -->
    <ProjectCard
      title="The Last Bite"
      detail="Book Design · 2025"
      href="/projects/last_bite"
      shape="landscape"
      image="/images/projects/last_bite/lb_hero_image.png"
      imageAlt="The Last Bite Book Cover"
    />

  <!-- Receipt Recipes -->
    <ProjectCard
      title="Receipt Recipes"
      detail="Book Design · 2024"
      href="/projects/receipt_recipes"
      shape="landscape"
      image="/images/projects/receipt_recipes/rr_hero_img.jpg"
      imageAlt="Recipe book titled: Receipt Recipes with Cocktail Recipe Book alongside"
    />

    <!-- Solough -->
    <ProjectCard
      title="Solough"
      detail="Font & Type Specimen · 2024"
      href="/projects/solough"
      shape="square"
      image="/images/projects/solough/s_hero_img.jpg"
      imageAlt="Font and Type specimen for custom typeface Solough"
    />

    <!-- Whisper Wind -->
    <ProjectCard
      title="Whispers of the Wind"
      detail="Public Exhibition · 2025"
      href="/projects/whisper_wind"
      shape="landscape"
      image="/images/projects/whisper_wind/ww_hero_img.JPG"
      imageAlt="Whispers of the Wind Public Exhibition featuring tapestry and board game."
    />

  </section>
</BaseLayout>
