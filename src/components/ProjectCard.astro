---
const { title, detail, href, shape = "landscape" } = Astro.props;
---

<article class="project-card">
  <a href={href}>
    <div class:list={["media-placeholder", `media-placeholder--${shape}`]} aria-hidden="true"></div>
    <div class="project-card__text">
      <h2>{title}</h2>
      {detail && <p>{detail}</p>}
    </div>
  </a>
</article>

